# env.example — mẫu biến môi trường cần đặt trước khi chạy demo.
# SAO CHÉP thành .env cùng thư mục và điền giá trị thật (KHÔNG commit .env).
#
# Quan trọng: KHÔNG ghi token/secret thật vào đây. Tất cả giá trị là ví dụ
# rỗng. Khi demo, dùng tài khoản fixture do người vận hành tạo sẵn trong
# DB demo riêng (xem scripts/seed_demo.py).

# ==== Backend ====
SGM_PORT=8000
SGM_BIND_HOST=127.0.0.1
SGM_LOG_DIR=logs_demo
# JWT secret bắt buộc khi chạy production; demo local có thể bỏ trống
SGM_JWT_SECRET=

# ==== Camera (RTSP LAN, IP local) ====
# Đặt IP thật của camera tại cổng demo; KHÔNG commit IP thật vào repo
SGM_CAM_FRONT_URL=rtsp://USER:PASSWORD@192.168.1.101:554/stream1
SGM_CAM_REAR_URL=rtsp://USER:PASSWORD@192.168.1.102:554/stream1
SGM_CAM_FRONT_ROI=0.2,0.4,0.8,0.95
SGM_CAM_REAR_ROI=0.2,0.4,0.8,0.95

# ==== Audio ====
# Đường dẫn tới Web Speech API voice local đã cài (hoặc bỏ trống để
# tự chọn giọng vi-VN có localService=true đầu tiên)
SGM_VOICE_LANG=vi-VN
# Thư mục clip câu lỗi lưu sẵn (fallback nếu máy không có giọng local)
SGM_AUDIO_FALLBACK_CLIPS=marketing/audio_clips

# ==== VPS (chỉ để probe, không nằm trên đường xử lý) ====
SGM_VPS_HOST=103.101.162.111
SGM_VPS_SSH_PORT=22
SGM_VPS_HTTP_PORT=80

# ==== Demo accounts ====
# Tạo sẵn bằng scripts/seed_demo.py — KHÔNG dùng tài khoản vận hành
SGM_DEMO_ADMIN_USER=demo_admin
SGM_DEMO_GUARD_USER=demo_guard
SGM_DEMO_PASSWORD=

# ==== Logging ====
# Không ghi log vào file nhạy cảm; chỉ log backend.out.log + backend.err.log
SGM_LOG_LEVEL=INFO