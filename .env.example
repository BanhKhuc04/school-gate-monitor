# Camera cổng chính (bắt buộc phải có ít nhất cổng này)
CAMERA_SOURCE=0
CAMERA_LOOP=1
GATE_MAIN_NAME=Cổng Chính

# Camera cổng phụ (tùy chọn) — set CAMERA_SOURCE_SECONDARY để bật cổng thứ 2,
# hệ thống tự ghép 1 lượt xe qua 2 camera (trước/sau) khi cả 2 đều đọc được
# biển số (xem app/cv/event_correlator.py). Để trống = chỉ chạy 1 cổng như cũ.
# Giá trị: index camera vật lý (0, 1, ...), đường dẫn file video, hoặc RTSP URL
# (vd. rtsp://user:pass@192.168.1.10:554/stream1).
CAMERA_SOURCE_SECONDARY=
GATE_SECONDARY_NAME=Cổng Phụ
GATE_SECONDARY_LOOP=1

# Optional extra camera choices: JSON array of {"label": "...", "source": "..."}.
# Keep camera passwords in .env only. Never paste credentials into source files.
CAMERA_PRESETS_JSON=
